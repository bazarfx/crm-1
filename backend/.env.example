# ---------------------------------------------------------------------------
# CRM 1 Backend — environment variables
# Copy to .env and fill in real values. NEVER commit .env.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=5000
API_VERSION=v1
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000

# Database (Supabase PostgreSQL)
# Either set DATABASE_URL OR the individual DB_* vars below. DATABASE_URL wins.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
DB_HOST=db.YOUR_PROJECT.supabase.co
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=YOUR_PASSWORD
DB_NAME=postgres
DB_SSL=true

# JWT
JWT_ACCESS_SECRET=replace-with-long-random-string
JWT_REFRESH_SECRET=replace-with-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# Ingest webhook (Integrately -> /api/v1/leads/ingest)
INGEST_TOKEN=replace-with-shared-secret

# ARK terminal webhook -> /api/v1/webhooks/ark
ARK_WEBHOOK_SECRET=replace-with-ark-shared-secret
# Optional comma-separated IP allowlist. Leave blank to disable IP check.
ARK_WEBHOOK_IPS=

# AdminJS (at /admin)
ADMIN_COOKIE_SECRET=replace-with-cookie-secret
ADMIN_COOKIE_NAME=adminjs
ADMIN_EMAIL=superadmin@thework.ltd
ADMIN_PASSWORD=Test@1234
