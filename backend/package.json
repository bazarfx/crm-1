{
  "name": "crm1-backend",
  "version": "0.1.0",
  "private": true,
  "description": "CRM 1 — Trading Telesales CRM backend (Express + Sequelize + Supabase PostgreSQL)",
  "main": "server.js",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node seeders/masterSeeder.js",
    "db:sync": "node -e \"require('./models').syncDatabase().then(()=>process.exit(0)).catch(e=>{console.error(e);process.exit(1)})\""
  },
  "dependencies": {
    "@adminjs/express": "^6.1.0",
    "@adminjs/sequelize": "^4.1.1",
    "@faker-js/faker": "^8.4.1",
    "adminjs": "^7.8.7",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-formidable": "^1.2.0",
    "express-rate-limit": "^7.4.0",
    "express-session": "^1.18.0",
    "helmet": "^7.1.0",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.12.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
